# Azure OpenAI / AI Foundry
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource-name>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
CHAT_DEPLOYMENT=chat
EMBED_DEPLOYMENT=embedding

# Azure AI Search (North Europe)
SEARCH_ENDPOINT=https://<your-search-service-name>.search.windows.net
SEARCH_INDEX_JOBS=jobs
SEARCH_INDEX_TAXONOMY=taxonomy

# Azure Cosmos DB (Sweden Central)
COSMOS_ENDPOINT=https://<your-cosmos-account-name>.documents.azure.com:443/
COSMOS_DB=hidden-talent
COSMOS_CONTAINER_CANDIDATES=candidates
COSMOS_CONTAINER_MATCHES=matches

# Azure Blob Storage
STORAGE_ACCOUNT_URL=https://<your-storage-account-name>.blob.core.windows.net
STORAGE_CONTAINER=datasets

# API Runtime
API_BASE_URL=http://localhost:8000
PROMPT_VERSION=v1
